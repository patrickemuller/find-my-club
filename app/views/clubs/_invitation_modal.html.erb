<div class="fixed inset-0 z-50 overflow-y-auto hidden" data-invitation-modal-target="modal">
  <!-- Backdrop -->
  <div class="fixed inset-0 bg-gray-500 opacity-50 dark:bg-gray-900 dark:opacity-50 transition-opacity" data-action="click->invitation-modal#close"></div>

  <!-- Modal -->
  <div class="flex min-h-full items-center justify-center p-4">
    <div class="relative w-full max-w-lg transform overflow-hidden rounded-lg bg-white shadow-xl transition-all dark:bg-gray-800">
      <!-- Header -->
      <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-gray-700">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Invite Members</h3>
        <button type="button" data-action="click->invitation-modal#close" class="text-gray-400 hover:text-gray-500">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Form -->
      <%= form_with url: club_club_invitations_path(club), method: :post, class: "p-6" do |form| %>
        <div class="space-y-4">
          <div>
            <label for="emails" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
              Email Addresses
            </label>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
              Enter one or more email addresses, separated by commas, semicolons, or new lines
            </p>
            <%= text_area_tag :emails, nil,
                rows: 6,
                placeholder: "member@example.com, another@example.com",
                class: "mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-orange-500 focus:ring-orange-500 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100" %>
          </div>
        </div>

        <!-- Actions -->
        <div class="mt-6 flex items-center justify-end gap-3">
          <button type="button" data-action="click->invitation-modal#close" class="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700">
            Cancel
          </button>
          <%= form.submit "Send Invitations", class: "rounded-md bg-orange-600 px-4 py-2 text-sm font-medium text-white hover:bg-orange-700" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
