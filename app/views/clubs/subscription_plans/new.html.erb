<div class="max-w-2xl mx-auto p-6">
  <h1 class="text-3xl font-bold mb-6">Create Subscription Plan</h1>

  <%= form_with model: @plan, url: club_subscription_plans_path(@club), method: :post, class: "space-y-6" do |form| %>
    <% if @plan.errors.any? %>
      <div id="error_explanation" class="bg-red-50 text-red-700 px-3 py-2 font-medium rounded-md my-3 border border-red-200 dark:bg-red-900/20 dark:text-red-300 dark:border-red-700">
        <h2><%= pluralize(@plan.errors.count, "error") %> prohibited this Subscription from being saved:</h2>
        <ul class="list-disc ml-6">
          <% @plan.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 space-y-4">
      <div>
        <%= form.label :name, "Plan Name", class: "block text-sm font-medium mb-2" %>
        <%= form.text_field :name, placeholder: "e.g., Premium Membership", class: "w-full px-4 py-2 border rounded-lg dark:bg-gray-700 dark:border-gray-600" %>
      </div>

      <div>
        <%= form.label :plan_type, "Plan Type", class: "block text-sm font-medium mb-2" %>
        <%= form.select :plan_type,
            options_for_select([
              ["Weekly", "week"],
              ["Monthly", "month"],
              ["Yearly", "year"]
            ]),
            { prompt: "Select plan type" },
            class: "w-full px-4 py-2 border rounded-lg dark:bg-gray-700 dark:border-gray-600" %>
      </div>

      <div>
        <%= form.label :price_cents, "Price (CAD)", class: "block text-sm font-medium mb-2" %>
        <%= form.number_field :price_cents, step: 0.01, placeholder: "20.00", class: "w-full px-4 py-2 border rounded-lg dark:bg-gray-700 dark:border-gray-600", value: form.object.price_in_dollars %>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Enter the price in CAD (e.g., 20.00)</p>
      </div>

      <div>
        <%= form.label :description, "Description (optional, 500 characters max)", class: "block text-sm font-medium mb-2" %>
        <%= form.text_area :description, placeholder: "Describe what this plan includes...", rows: 4, maxlength: 500, class: "w-full px-4 py-2 border rounded-lg dark:bg-gray-700 dark:border-gray-600" %>
      </div>
    </div>

    <div class="flex justify-end gap-4">
      <%= link_to "Cancel", club_payments_path(@club), class: "px-6 py-2 border rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700" %>
      <%= form.submit "Create Plan", class: "cursor-pointer bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-6 rounded-lg" %>
    </div>
  <% end %>
</div>
