<div class="max-w-2xl mx-auto p-6">
  <h1 class="text-3xl font-bold mb-6">Edit Subscription Plan</h1>

  <%= form_with model: @plan, url: club_subscription_plan_path(@club, @plan), method: :patch, class: "space-y-6" do |form| %>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 space-y-4">
      <div class="flex items-center">
        <%= form.check_box :active, class: "mr-2 h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:bg-gray-700 dark:border-gray-600" %>
        <%= form.label :active, "Active (allow new subscriptions to this plan)", class: "text-sm font-medium" %>
      </div>

      <div>
        <%= form.label :name, "Plan Name", class: "block text-sm font-medium mb-2" %>
        <%= form.text_field :name, placeholder: "e.g., Premium Membership", class: "w-full px-4 py-2 border rounded-lg dark:bg-gray-700 dark:border-gray-600" %>
      </div>

      <div>
        <%= form.label :description, "Description (optional, 500 characters max)", class: "block text-sm font-medium mb-2" %>
        <%= form.text_area :description, placeholder: "Describe what this plan includes...", rows: 4, maxlength: 500, class: "w-full px-4 py-2 border rounded-lg dark:bg-gray-700 dark:border-gray-600" %>
      </div>

      <div class="bg-gray-50 dark:bg-gray-900/50 border border-gray-200 dark:border-gray-700 rounded-lg p-4 space-y-2">
        <p class="text-sm text-gray-600 dark:text-gray-400">
          <strong>Plan Type:</strong> <%= @plan.plan_type.capitalize %>
        </p>
        <p class="text-sm text-gray-600 dark:text-gray-400">
          <strong>Price:</strong> $<%= sprintf("%.2f", @plan.price_in_dollars) %> CAD per <%= @plan.interval %>
        </p>
        <p class="text-xs text-gray-500 dark:text-gray-500 mt-2">
          <span>Price and plan type cannot be changed. Create a new plan if you need different pricing.</span>
          <br>
          <span>This is to prevent issues with the recurring payments for existing memberships.</span>
        </p>
      </div>
    </div>

    <div class="flex justify-end gap-4">
      <%= link_to "Cancel", club_payments_path(@club), class: "px-6 py-2 border rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700" %>
      <%= form.submit "Update Plan", class: "cursor-pointer bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-6 rounded-lg" %>
    </div>
  <% end %>
</div>
